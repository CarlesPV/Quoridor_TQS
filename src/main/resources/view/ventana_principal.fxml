<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.quoridor.view.VentanaPrincipalJavaFX"
            stylesheets="@styles.css"
            styleClass="root-pane">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="header-bar">
            <padding>
                <Insets top="14.0" right="20.0" bottom="14.0" left="20.0"/>
            </padding>
            <Label text="QUORIDOR" styleClass="app-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="10.0" styleClass="turn-badge">
                <Circle fx:id="indicadorTurno" radius="9.0" styleClass="indicador-turno"/>
                <Label fx:id="lblTurno" text="Turno: -" styleClass="turn-label"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <StackPane styleClass="board-container">
            <padding>
                <Insets top="16.0" right="16.0" bottom="16.0" left="20.0"/>
            </padding>
            <GridPane fx:id="tableroGrid" alignment="CENTER" styleClass="tablero-grid"/>
        </StackPane>
    </center>

    <right>
        <VBox spacing="16.0" prefWidth="250.0" styleClass="info-panel">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="16.0"/>
            </padding>
            <Label text="Panel de Partida" styleClass="panel-title"/>
            <Separator/>
            <Label text="Muros restantes" styleClass="section-title"/>
            <VBox fx:id="panelMurosRestantes" spacing="8.0" styleClass="muros-lista"/>
            <Separator/>
            <VBox spacing="6.0" styleClass="legend-box">
                <Label text="Controles" styleClass="section-title"/>
                <Label text="• Clic en casilla: mover peón" wrapText="true" styleClass="legend-text"/>
                <Label text="• Clic en ranura horizontal o vertical: colocar muro" wrapText="true"
                       styleClass="legend-text"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Button fx:id="btnReiniciar" text="Reiniciar Partida" maxWidth="Infinity"
                    onAction="#manejarReiniciar" styleClass="restart-button"/>
        </VBox>
    </right>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="status-bar">
            <padding>
                <Insets top="10.0" right="20.0" bottom="10.0" left="20.0"/>
            </padding>
            <Label fx:id="lblMensaje" text="Listo para jugar." maxWidth="Infinity" HBox.hgrow="ALWAYS"
                   styleClass="status-message"/>
        </HBox>
    </bottom>

</BorderPane>
